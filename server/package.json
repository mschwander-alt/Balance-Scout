{
  "name": "balance-scout-server",
  "version": "0.3.0",
  "private": true,
  "description": "Balance Scout – Server für Saldennachweis-Prüfung (Schritt 1: Import, Validierung, deterministisches Matching)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://bsb:bsb@localhost:5432/bsb_test} vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/msal-node": "^7.2.1",
    "@fastify/multipart": "^10.1.8",
    "@napi-rs/canvas": "^1.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}