# Balance Scout Server – Beispielkonfiguration (lokal). In Azure setzt deploy.sh alles automatisch.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://bsb:bsb@localhost:5432/bsb
# require = TLS mit Zertifikatsprüfung (Pflicht in Azure)
DATABASE_SSL=disable
STORAGE_DIR=./data/files
MAX_UPLOAD_MB=50
LOG_LEVEL=info

# ---------- Anmeldung ----------
# entra = Microsoft-Anmeldung (Produktiv) | tokens = feste Tokens | dev = ohne Anmeldung (nur lokal)
AUTH_MODE=dev
ENTRA_TENANT_ID=
# Audience der Server-API, z. B. api://<API-App-ID>,<API-App-ID>
ENTRA_API_AUDIENCE=
ENTRA_ADMIN_ROLE=BalanceScout.Admin
ENTRA_USER_ROLE=BalanceScout.User
# Nur für AUTH_MODE=tokens: "token:benutzer" kommagetrennt, ADMIN_USERS = Admins
API_TOKENS=
ADMIN_USERS=

# Entra-App des Servers (On-Behalf-Of für Copilot und SharePoint)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---------- SharePoint (Ablage der Belege für Copilot) ----------
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_FOLDER=Balance Scout

# ---------- KI ----------
AI_TIMEOUT_MS=120000
AI_TIMEZONE=Europe/Zurich

# Microsoft 365 Copilot – workiq (allgemein verfügbar, Copilot Credits) oder graph-beta (Vorschau)
M365_COPILOT_ENABLED=false
M365_COPILOT_VARIANT=workiq

# Azure AI Foundry (Schweiz Nord). In Azure: verwaltete Identität statt Schlüssel.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_DEPLOYMENT=
AZURE_FOUNDRY_API_KEY=
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# Ollama (lokal im Kanzleinetz)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
