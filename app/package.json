{
  "name": "balance-scout-lokal",
  "productName": "Balance Scout",
  "version": "0.20.0",
  "private": true,
  "description": "Balance Scout – lokale Saldennachweis-Prüfung (ohne Server, ohne Cloud)",
  "main": "dist-electron/main.js",
  "author": "Balance Scout",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@balance-scout/engine": "file:../engine",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wasm-feature-detect": "1.9.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "ch.balancescout.lokal",
    "productName": "Balance Scout",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "node_modules/@balance-scout/engine/tessdata",
        "to": "tessdata"
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "*.png"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BalanceScout-Lokal-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Balance Scout Lokal"
    },
    "msi": {
      "perMachine": true,
      "oneClick": false,
      "createDesktopShortcut": true,
      "shortcutName": "Balance Scout Lokal"
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  },
  "overrides": {
    "uuid": "^11.1.1",
    "wasm-feature-detect": "1.9.0"
  }
}
